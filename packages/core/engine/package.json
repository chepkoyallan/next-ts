{
  "name": "@app/engine",
  "version": "1.0.0",
  "private": true,
  "description": "gRPC engine and service clients",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./grpc/*": "./src/grpc/*.ts",
    "./services/*": "./src/services/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@app/types": "workspace:*",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "grpc",
    "engine",
    "services"
  ],
  "license": "MIT"
}
