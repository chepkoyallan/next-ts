    "db:pull": "prisma db pull",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:setup": "npm run db:migrate && npm run db:generate && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
