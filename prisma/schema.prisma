// Revenue System Prisma Schema
// Complete schema for orchestrator platform revenue system

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_DATABASE_URL") // Commented out for Accelerate-only usage
}

// ============================================================================
// USER MANAGEMENT MODELS
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  emailVerified Boolean @default(false) @map("email_verified")
  
  // Profile fields
  photoURL     String?  @map("photo_url")
  phoneNumber  String?  @map("phone_number")
  country      String?
  address      String?
  state        String?
  city         String?
  zipCode      String?  @map("zip_code")
  about        String?
  isPublic     Boolean  @default(false) @map("is_public")
  
  // Social links (JSON field)
  socialLinks  Json?    @map("social_links")
  
  // Notification preferences (JSON field)
  notificationPreferences Json? @map("notification_preferences")
  
  // 2FA fields
  twoFactorEnabled     Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret      String? @map("two_factor_secret")
  twoFactorBackupCodes Json?   @map("two_factor_backup_codes")
  
  // Activity tracking
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip")

  // Legacy fields
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  userRoles           UserRole[]
  executionUsage      ExecutionUsage[]
  featureUsage        FeatureUsage[]
  featureAccessLogs   FeatureAccessLog[]
  auditLogs           AuditLog[]
  gdprRequests        GdprRequest[]
  workflowReviews     WorkflowReview[]
  organizationMembers OrganizationMember[]
  featureFlagOverrides FeatureFlagOverride[]
  billingAddresses    BillingAddress[]

  @@map("users")
}

model Organization {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  logoUrl     String?             @map("logo_url")
  website     String?
  industry    String?
  size        String?             // SMALL, MEDIUM, LARGE, ENTERPRISE
  status      OrganizationStatus  @default(ACTIVE)
  ownerId     String?             @map("owner_id")

  // Settings and metadata
  settings    Json                @default("{}")  // SSO, branding, security policies
  metadata    Json                @default("{}")

  // Timestamps
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  // Relations
  billingAccounts      BillingAccount[]
  projects             Project[]
  members              OrganizationMember[]
  invitations          OrganizationInvitation[]
  formSchemas          FormSchema[]
  formAssignments      FormAssignment[]
  formSubmissions      FormSubmission[]
  featureFlagOverrides FeatureFlagOverride[]
  connectors           ConnectorConfig[]
  bmaasInstances       BmaasInstance[]
  bmaasNetworks        BmaasNetwork[]
  bmaasVolumes         BmaasVolume[]
  bmaasBuckets         BmaasBucket[]
  bmaasUsageRecords    BmaasUsageRecord[]
  bmaasQuota           BmaasQuota?

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(MEMBER)
  invitedBy      String?          @map("invited_by")
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")
  isActive       Boolean          @default(true) @map("is_active")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([isActive])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           OrganizationRole @default(MEMBER)
  token          String           @unique
  invitedBy      String           @map("invited_by")
  message        String?
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  domain         String   @default("development")

  // Flyte integration fields (optional for backwards compatibility)
  flyteProjectId String?  @map("flyte_project_id") // Shared Flyte project ID (e.g., "aus") - multiple UI projects map to one Flyte project
  flyteOrgPrefix String?  @map("flyte_org_prefix")         // The organization prefix used (e.g., "org-abc123")
  flyteState     Int      @default(0) @map("flyte_state")  // 0=ACTIVE, 1=ARCHIVED, 2=SYSTEM
  flyteDomains   Json     @default("[]") @map("flyte_domains") // List of domain objects
  createdBy      String?  @map("created_by")               // User who created this project
  isArchived     Boolean  @default(false) @map("is_archived")

  settings       Json     @default("{}")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions     Subscription[]
  usageRecords      UsageRecord[]
  executionUsage    ExecutionUsage[]
  featureUsage      FeatureUsage[]
  auditLogs         AuditLog[]
  metrics           Metric[]
  alerts            Alert[]
  workflowPurchases WorkflowPurchase[]
  workflows         Workflow[]
  launchPlans       LaunchPlan[]
  workflowExecutions WorkflowExecution[]
  bmaasInstances    BmaasInstance[]
  bmaasNetworks     BmaasNetwork[]
  bmaasVolumes      BmaasVolume[]
  bmaasBuckets      BmaasBucket[]
  bmaasUsageRecords BmaasUsageRecord[]

  // ⚡ Performance indexes
  @@index([organizationId])
  @@index([createdBy])
  @@index([flyteOrgPrefix])
  @@index([isArchived])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, isArchived])
  @@index([createdBy, deletedAt])
  @@map("projects")
}

// ============================================================================
// RBAC MODELS
// ============================================================================

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String
  conditions  Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  hierarchy    Int      @default(0)
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  assignedBy String    @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  context    Json      @default("{}")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// WORKFLOW ORCHESTRATION MODELS
// ============================================================================

model Workflow {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  organizationId  String   @map("organization_id")  // For direct org filtering
  domain          String
  name            String
  version         String
  description     String?
  spec            Json
  compiledWorkflow Json?   @map("compiled_workflow")
  status          WorkflowStatus @default(ACTIVE)

  // Flyte integration fields
  flyteWorkflowId String   @unique @map("flyte_workflow_id") // Full Flyte ID: "org-abc123-proj:domain:name:version"
  createdBy       String?  @map("created_by")                // User who created this workflow
  isDeleted       Boolean  @default(false) @map("is_deleted")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]
  launchPlans LaunchPlan[]

  @@unique([projectId, domain, name, version])
  @@index([organizationId])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("workflows")
}

model LaunchPlan {
  id             String   @id @default(cuid())
  workflowId     String   @map("workflow_id")
  projectId      String   @map("project_id")
  organizationId String   @map("organization_id")  // For direct org filtering
  domain         String
  name           String
  version        String
  spec           Json
  schedule       Json?
  status         LaunchPlanStatus @default(ACTIVE)

  // Flyte integration fields
  flyteLaunchPlanId String   @unique @map("flyte_launch_plan_id") // Full Flyte ID
  createdBy         String?  @map("created_by")
  isDeleted         Boolean  @default(false) @map("is_deleted")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@unique([projectId, domain, name, version])
  @@index([organizationId])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("launch_plans")
}

model WorkflowExecution {
  id             String   @id @default(cuid())
  executionId    String   @unique @map("execution_id")
  workflowId     String?  @map("workflow_id")
  launchPlanId   String?  @map("launch_plan_id")
  projectId      String   @map("project_id")
  organizationId String   @map("organization_id")  // For direct org filtering
  domain         String
  name           String
  phase          ExecutionPhase @default(UNDEFINED)
  startedAt      DateTime? @map("started_at")
  duration       Int?      // milliseconds
  inputs         Json      @default("{}")
  outputs        Json?
  error          Json?
  metadata       Json      @default("{}")

  // Flyte integration fields
  flyteExecutionId String   @map("flyte_execution_id") // Flyte execution ID
  createdBy        String?  @map("created_by")         // User who created this execution

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  workflow   Workflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  launchPlan LaunchPlan? @relation(fields: [launchPlanId], references: [id], onDelete: SetNull)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdBy])
  @@index([phase])
  @@map("workflow_executions")
}

model Task {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  organizationId String   @map("organization_id")  // For direct org filtering
  domain         String
  name           String
  version        String
  description    String?
  spec           Json

  // Flyte integration fields
  flyteTaskId    String   @unique @map("flyte_task_id") // Full Flyte ID: "org-abc123-proj:domain:name:version"
  createdBy      String?  @map("created_by")            // User who created this task
  isDeleted      Boolean  @default(false) @map("is_deleted")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([projectId, domain, name, version])
  @@index([organizationId])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("tasks")
}

// ============================================================================
// BILLING SYSTEM CORE MODELS
// ============================================================================

model BillingAccount {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String
  email             String
  status            BillingAccountStatus @default(ACTIVE)
  paymentMethodId   String?  @map("payment_method_id")
  billingAddress    Json?    @map("billing_address")
  taxId             String?  @map("tax_id")
  currency          String   @default("USD")
  metadata          Json     @default("{}")

  // Stripe integration fields
  stripeCustomerId  String?  @unique @map("stripe_customer_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  invoices        Invoice[]
  paymentHistory  PaymentHistory[]
  billingAlerts   BillingAlert[]
  paymentMethods  PaymentMethod[]
  billingAddresses BillingAddress[]

  @@map("billing_accounts")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  tier        PlanTier
  pricing     Json
  features    Json
  limits      Json
  isActive    Boolean  @default(true) @map("is_active")

  // Stripe integration
  stripePriceId   String? @unique @map("stripe_price_id")
  stripeProductId String? @map("stripe_product_id")
  trialDays       Int?    @map("trial_days")
  metadata        Json?   @default("{}")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  billingAccountId       String             @map("billing_account_id")
  projectId              String             @map("project_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  trialStart             DateTime?          @map("trial_start")
  trialEnd               DateTime?          @map("trial_end")
  cancelAt               DateTime?          @map("cancel_at")
  canceledAt             DateTime?          @map("canceled_at")
  metadata               Json               @default("{}")

  // Stripe integration fields
  stripeSubscriptionId   String?            @unique @map("stripe_subscription_id")

  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  usageRecords   UsageRecord[]
  invoices       Invoice[]

  @@map("subscriptions")
}

model UsageRecord {
  id             String   @id @default(cuid())
  subscriptionId String   @map("subscription_id")
  projectId      String   @map("project_id")
  metric         UsageMetric
  quantity       Decimal  @db.Decimal(15, 6)
  unit           String
  timestamp      DateTime
  metadata       Json     @default("{}")
  cost           Decimal  @default(0) @db.Decimal(10, 4)
  currency       String   @default("USD")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model ExecutionUsage {
  id            String          @id @default(cuid())
  executionId   String          @unique @map("execution_id")
  projectId     String          @map("project_id")
  workflowId    String          @map("workflow_id")
  userId        String          @map("user_id")
  domain        String?
  startTime     DateTime        @map("start_time")
  endTime       DateTime?       @map("end_time")
  duration      Int?            // seconds
  status        ExecutionStatus
  resourceUsage Json            @map("resource_usage")
  cost          Json
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("execution_usage")
}

// ============================================================================
// FEATURE GATING MODELS
// ============================================================================

model FeatureGate {
  id                  String   @id @default(cuid())
  feature             String   @unique
  name                String
  description         String?
  requiredPlans       String[] @map("required_plans")
  requiredPermissions String[] @default([]) @map("required_permissions")
  usageLimit          Int?     @map("usage_limit")
  usagePeriod         String   @default("monthly") @map("usage_period")
  isActive            Boolean  @default(true) @map("is_active")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  featureUsage      FeatureUsage[]
  featureAccessLogs FeatureAccessLog[]
  featureOverrides  FeatureOverride[]

  @@map("feature_gates")
}

model FeatureUsage {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  feature     String
  usageCount  Int      @default(0) @map("usage_count")
  resetPeriod String   @default("monthly") @map("reset_period")
  lastUsed    DateTime @default(now()) @map("last_used")
  lastReset   DateTime @default(now()) @map("last_reset")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureGate FeatureGate @relation(fields: [feature], references: [feature])

  @@unique([userId, projectId, feature, resetPeriod])
  @@map("feature_usage")
}

// ============================================================================
// CORE ENUMS
// ============================================================================

enum BillingAccountStatus {
  ACTIVE
  SUSPENDED
  DELINQUENT
  CLOSED

  @@map("billing_account_status")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID

  @@map("subscription_status")
}

enum PlanTier {
  FREE
  BASIC
  STARTER
  PROFESSIONAL
  PREMIUM
  ENTERPRISE

  @@map("plan_tier")
}

enum UsageMetric {
  EXECUTIONS
  CPU_HOURS
  MEMORY_GB_HOURS
  STORAGE_GB
  NETWORK_GB
  USERS
  PROJECTS
  FORMS
  FORM_SUBMISSIONS
  FORM_FIELDS
  FORM_ASSIGNMENTS
  CONNECTORS
  CONNECTOR_CALLS
  WORKFLOWS
  WORKFLOW_DRAFTS
  WORKFLOW_VERSIONS
  MARKETPLACE_LISTINGS
  WORKFLOW_PURCHASES
  ALERTS
  ALERT_RULES
  API_KEYS
  API_CALLS
  WEBHOOK_ENDPOINTS
  CUSTOM_ROLES
  ORGANIZATIONS
  INVITATIONS
  COMMENTS
  TASKS
  LAUNCH_PLANS
  SUPPORT_TICKETS

  @@map("usage_metric")
}

enum ExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABORTED
  TIMED_OUT

  @@map("execution_status")
}

// ============================================================================
// INVOICING AND PAYMENTS
// ============================================================================

model Invoice {
  id               String        @id @default(cuid())
  billingAccountId String        @map("billing_account_id")
  subscriptionId   String?       @map("subscription_id")
  invoiceNumber    String        @unique @map("invoice_number")
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(10, 2)
  tax              Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  periodStart      DateTime      @map("period_start")
  periodEnd        DateTime      @map("period_end")
  dueDate          DateTime      @map("due_date")
  paidAt           DateTime?     @map("paid_at")
  lineItems        Json          @default("[]") @map("line_items")
  metadata         Json          @default("{}")

  // Stripe integration fields
  stripeInvoiceId  String?       @unique @map("stripe_invoice_id")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentHistory PaymentHistory[]

  @@map("invoices")
}

model PaymentHistory {
  id               String        @id @default(cuid())
  billingAccountId String        @map("billing_account_id")
  invoiceId        String?       @map("invoice_id")
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  status           PaymentStatus
  paymentMethod    String?       @map("payment_method")
  transactionId    String?       @map("transaction_id")
  failureReason    String?       @map("failure_reason")
  metadata         Json          @default("{}")
  processedAt      DateTime      @default(now()) @map("processed_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payment_history")
}

model BillingAlert {
  id               String            @id @default(cuid())
  billingAccountId String            @map("billing_account_id")
  type             BillingAlertType
  severity         AlertSeverity
  message          String
  threshold        Decimal?          @db.Decimal(15, 6)
  currentValue     Decimal?          @db.Decimal(15, 6) @map("current_value")
  isResolved       Boolean           @default(false) @map("is_resolved")
  resolvedAt       DateTime?         @map("resolved_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("billing_alerts")
}

model PaymentMethod {
  id               String   @id @default(cuid())
  billingAccountId String   @map("billing_account_id")
  type             String   @default("card") // card, bank_account, etc.

  // Card details (last 4, brand, expiry)
  brand            String?  // visa, mastercard, amex, etc.
  last4            String?
  expiryMonth      Int?     @map("expiry_month")
  expiryYear       Int?     @map("expiry_year")

  // Status
  isDefault        Boolean  @default(false) @map("is_default")
  isExpired        Boolean  @default(false) @map("is_expired")

  // Stripe integration
  stripePaymentMethodId String? @unique @map("stripe_payment_method_id")

  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model BillingAddress {
  id               String   @id @default(cuid())
  billingAccountId String?  @map("billing_account_id")
  userId           String?  @map("user_id")

  // Address details
  name             String
  line1            String
  line2            String?
  city             String
  state            String?
  postalCode       String   @map("postal_code")
  country          String
  phoneNumber      String?  @map("phone_number")

  // Status
  isDefault        Boolean  @default(false) @map("is_default")

  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
