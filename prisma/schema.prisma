// ============================================================================
// FORM GENERATION MODELS
// ============================================================================

model FormSchema {
  id             String   @id @default(cuid())
  name           String
  description    String?
  version        String   @default("1.0.0")
  schema         Json     // JSON Schema object
  uischema       Json?    // UI Schema for layout customization
  dataSources    Json?    @map("data_sources") // Data source configurations for form fields (EnhancedFormSchema.dataSources)
  dependencies   Json?    // Field dependencies for dynamic form behavior
  tags           String[] @default([])
  category       String   @default("general")
  organizationId String?  @map("organization_id")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Usage tracking
  assignmentCount Int       @default(0) @map("assignment_count")
  lastUsed        DateTime? @map("last_used")
  popularity      Int       @default(0)

  // Relations
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  FormAssignment[]
  tasksAsInput  TaskDefinition[] @relation("TaskInputSchema")
  tasksAsOutput TaskDefinition[] @relation("TaskOutputSchema")

  @@index([organizationId])
  @@index([category])
  @@index([createdBy])
  @@index([createdAt])
  @@map("form_schemas")
}

model FormAssignment {
  id             String   @id @default(cuid())
  schemaId       String   @map("schema_id")
  organizationId String?  @map("organization_id")

  // Task/Workflow identification (Flyte resource)
  targetType     String   // 'task' | 'workflow' | 'launchplan'
  targetProject  String   @map("target_project")
  targetDomain   String   @map("target_domain")
  targetName     String   @map("target_name")
  targetVersion  String   @map("target_version")

  assignmentType String   @map("assignment_type") // input, output, config
  status         String   @default("active") // active, inactive, draft
  configuration  Json?
  name           String?
  description    String?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schema       FormSchema       @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]

  @@unique([targetProject, targetDomain, targetName, targetVersion, assignmentType])
  @@index([schemaId])
  @@index([targetType])
  @@index([status])
  @@index([organizationId])
  @@map("form_assignments")
}

model FormSubmission {
  id             String    @id @default(cuid())
  assignmentId   String    @map("assignment_id")
  organizationId String?   @map("organization_id")
  data           Json      // Form data
  isValid        Boolean   @map("is_valid")
  errors         Json      // Validation errors array
  submittedBy    String?   @map("submitted_by")
  submittedAt    DateTime? @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Analytics fields
  completionTime Int?    @map("completion_time") // seconds to complete form
  status         String  @default("success") // success, failed, abandoned
  schemaId       String? @map("schema_id") // denormalized for analytics
  taskId         String? @map("task_id") // denormalized for analytics

  // Relations
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment   FormAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([isValid])
  @@index([submittedBy])
  @@index([createdAt])
  @@index([status])
  @@index([schemaId])
  @@index([organizationId])
  @@map("form_submissions")
}

// ============================================================================
// WORKFLOW BUILDER MODELS
// ============================================================================

model WorkflowDraft {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")  // Multi-tenancy (nullable for backwards compatibility)
  name           String
  description    String?

  // Flyte project/domain
  project     String
  domain      String
  version     String

  // Workflow definition (serialized)
  nodes            Json     // WorkflowBuilderNode[]
  edges            Json     // WorkflowBuilderEdge[]
  workflowInputs   Json?    @map("workflow_inputs")   // Workflow input parameters
  workflowOutputs  Json?    @map("workflow_outputs")  // Workflow output parameters
  metadata         Json?    // Additional metadata (tags, author, etc.)

  // Status
  status      String   @default("draft")  // 'draft' | 'deployed' | 'archived'

  // Metadata
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Deployment info (if deployed)
  deployedAt  DateTime? @map("deployed_at")
  deployedBy  String?   @map("deployed_by")
  workflowId  String?   @map("workflow_id")  // Flyte workflow ID

  @@unique([name, project, domain, version, organizationId])
  @@index([status])
  @@index([createdBy])
  @@index([organizationId])
  @@index([createdAt])
  @@map("workflow_drafts")
}

// ============================================================================
// CONNECTOR MODELS
// ============================================================================

model ConnectorConfig {
  id              String   @id @default(cuid())
  name            String
  description     String?

  // Multi-tenancy
  organizationId  String   @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Connector type
  type            String   // 'rest_api' | 'database' | 'cloud_storage' | 'flyte_workflow' | 'graphql' | 'webhook' | 'custom'

  // Configuration (JSON)
  configuration   Json     // Type-specific config (RestApiConnectorConfig, DatabaseConnectorConfig, etc.)
  authentication  Json?    // Encrypted auth credentials (AuthenticationConfig)
  schema          Json?    // Expected output schema (JSONSchema7)
  dataMapping     Json?    @map("data_mapping")  // Data mapping configuration (DataMapping)

  // Behavior configuration
  caching         Json?    // Cache configuration (CacheConfig)
  rateLimit       Json?    @map("rate_limit")  // Rate limiting configuration (RateLimitConfig)
  healthCheckConfig Json? @map("health_check_config")  // Health check configuration (HealthCheckConfig)

  // Health status
  status          String   @default("active")  // 'active' | 'inactive' | 'error' | 'testing'
  lastHealthCheck DateTime? @map("last_health_check")
  healthStatus    String?   @map("health_status")  // 'healthy' | 'unhealthy' | 'unknown' | 'degraded'

  // Statistics
  totalExecutions      Int @default(0) @map("total_executions")
  successfulExecutions Int @default(0) @map("successful_executions")
  failedExecutions     Int @default(0) @map("failed_executions")
  averageResponseTime  Float? @map("average_response_time")  // in milliseconds

  // Auto-matching metadata for form field enrichment
  tags            String[] @default([])  // Tags for automatic field matching (e.g., ["customers", "crm"])
  category        String?                // Category for organization (e.g., "crm", "inventory", "hr")

  // Metadata
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  auditLogs       ConnectorAuditLog[]

  @@index([type])
  @@index([status])
  @@index([organizationId])
  @@index([createdBy])
  @@index([healthStatus])
  @@index([category])
  @@index([organizationId, createdAt(sort: Desc)]) // ⚡ Composite index for list queries
  @@index([organizationId, type, status]) // ⚡ Composite index for filtered list queries
  @@map("connector_configs")
}

// ============================================================================
// CONNECTOR AUDIT LOG
// ============================================================================

model ConnectorAuditLog {
  id             String   @id @default(cuid())
  connectorId    String   @map("connector_id")
  connector      ConnectorConfig @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  // Action details
  action         String   // 'created' | 'updated' | 'deleted' | 'executed' | 'tested' | 'health_check'
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")

  // Execution details
  queryParams    Json?    @map("query_params")  // ConnectorQueryParams
  result         Json?    // ExecutionResult summary

  // Change tracking
  changes        Json?    // Array of { field, oldValue, newValue }

  // Metadata
  metadata       Json?
  timestamp      DateTime @default(now())

  @@index([connectorId])
  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([timestamp])
  @@map("connector_audit_logs")
}

// ============================================================================
// TASK DEVELOPMENT MODELS (Pydantic-Enforced Tasks)
// ============================================================================

model TaskDefinition {
  id              String   @id @default(cuid())
  name            String
  description     String?
  organizationId  String   @map("organization_id")
  projectId       String   @map("project_id")
  domain          String   @default("development")

  // Schema enforcement - Tasks MUST have input/output schemas
  inputSchemaId   String   @map("input_schema_id")
  outputSchemaId  String   @map("output_schema_id")

  inputSchema     FormSchema @relation("TaskInputSchema", fields: [inputSchemaId], references: [id])
  outputSchema    FormSchema @relation("TaskOutputSchema", fields: [outputSchemaId], references: [id])

  // Generated Pydantic models (read-only, auto-generated from schemas)
  generatedInputModel  String  @map("generated_input_model") @db.Text  // Python code for input Pydantic model
  generatedOutputModel String  @map("generated_output_model") @db.Text // Python code for output Pydantic model

  // Dynamic function signature (user-defined)
  functionName    String   @default("process_data") @map("function_name") // e.g., "process_data", "transform", "validate"
  parameterName   String   @default("input_data") @map("parameter_name")   // e.g., "input_data", "data", "request"
  inputTypeName   String   @default("InputType") @map("input_type_name")  // e.g., "UserInput", "DataInput" (from schema name)
  outputTypeName  String   @default("OutputType") @map("output_type_name") // e.g., "UserOutput", "ProcessedData" (from schema name)

  // User's task logic (validated to enforce Pydantic usage)
  taskCode        String   @db.Text // Complete Python task code (includes models + logic)

  // Dependencies
  baseImage       String   @default("minimal-python") @map("base_image") // Base image: minimal-python, data-science, ml-gpu
  extraDependencies Json   @default("[]") @map("extra_dependencies") // Additional pip packages: ["pandas==2.0.0"]

  // Validation status
  isValid         Boolean  @default(false) @map("is_valid")
  validationErrors Json?   @map("validation_errors") // Array of validation error messages
  lastValidated   DateTime? @map("last_validated")

  // Flyte registration
  flyteTaskId      String?  @unique @map("flyte_task_id") // Full Flyte ID after registration
  registeredAt     DateTime? @map("registered_at")
  registrationStatus TaskRegistrationStatus @default(NOT_REGISTERED) @map("registration_status")
  registrationError String? @map("registration_error") @db.Text
  version          String   @default("1.0.0")

  // Metadata
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, projectId, domain, name, version])
  @@index([organizationId])
  @@index([projectId])
  @@index([inputSchemaId])
  @@index([outputSchemaId])
  @@index([isValid])
  @@index([createdBy])
  @@index([flyteTaskId])
  @@index([registrationStatus])
  @@map("task_definitions")
}

enum TaskRegistrationStatus {
  NOT_REGISTERED
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("task_registration_status")
}

// ============================================================================
// AI PROVIDER MODELS (AI-Powered Code Generation)
// ============================================================================

model AIProviderKey {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")

  // Provider details
  provider       String   // "openai", "anthropic", "google", "azure_openai"
  keyName        String   @map("key_name") // User-friendly name (e.g., "Work Account", "Personal")
  encryptedKey   String   @map("encrypted_key") @db.Text // AES-256 encrypted API key
  model          String?  // Preferred model (gpt-4-turbo, claude-3-5-sonnet, etc)

  // Status
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")

  // Usage tracking
  usageCount     Int      @default(0) @map("usage_count")
  lastUsedAt     DateTime? @map("last_used_at")
  totalCostUsd   Decimal  @default(0) @db.Decimal(10, 4) @map("total_cost_usd")

  // Connection test
  lastTestedAt   DateTime? @map("last_tested_at")
  testStatus     String?   @map("test_status") // "success", "failed", "pending"
  testError      String?   @map("test_error")

  // Metadata
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  generationLogs AIGenerationLog[]

  @@unique([userId, provider, keyName])
  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@index([isDefault])
  @@index([isActive])
  @@map("ai_provider_keys")
}

model AIGenerationLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  taskId         String?  @map("task_id") // TaskDefinition ID if generation was for a task
  providerKeyId  String   @map("provider_key_id")

  // Generation details
  generationType String   @map("generation_type") // "generate", "explain", "improve", "refactor"
  provider       String   // "openai", "anthropic", "google", "azure_openai"
  model          String   // "gpt-4-turbo", "claude-3-5-sonnet", etc

  // Input/Output
  prompt         String   @db.Text // The full prompt sent to AI
  userDescription String? @db.Text @map("user_description") // User's original request
  generatedCode  String   @db.Text @map("generated_code") // AI-generated code

  // Context (what was provided to AI)
  inputSchema    Json?    @map("input_schema") // Input schema snapshot
  outputSchema   Json?    @map("output_schema") // Output schema snapshot
  functionName   String?  @map("function_name") // Function name being generated
  existingCode   String?  @db.Text @map("existing_code") // If improving existing code

  // Usage metrics
  tokensUsed     Int      @map("tokens_used")
  promptTokens   Int?     @map("prompt_tokens")
  completionTokens Int?   @map("completion_tokens")
  costUsd        Decimal  @db.Decimal(10, 6) @map("cost_usd")
  generationTimeMs Int    @map("generation_time_ms") // milliseconds

  // Result status
  success        Boolean
  errorMessage   String?  @map("error_message")
  errorCode      String?  @map("error_code")

  // User feedback (optional)
  wasAccepted    Boolean? @map("was_accepted") // Did user accept/insert the generated code?
  userRating     Int?     @map("user_rating") // 1-5 stars
  userFeedback   String?  @db.Text @map("user_feedback")

  // Metadata
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  providerKey    AIProviderKey @relation(fields: [providerKeyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([taskId])
  @@index([providerKeyId])
  @@index([provider])
  @@index([generationType])
  @@index([success])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)]) // For user's generation history
  @@index([organizationId, createdAt(sort: Desc)]) // For org analytics
  @@map("ai_generation_logs")
}

// ============================================================================
// USER SETTINGS MODEL
// ============================================================================

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")

  // General Settings
  autoSave         Boolean @default(true) @map("auto_save")
  autoSaveInterval Int     @default(30) @map("auto_save_interval")
  defaultView      String  @default("grid") @map("default_view") // grid, list, kanban
  itemsPerPage     Int     @default(20) @map("items_per_page")

  // Theme & Appearance
  themeMode        String  @default("auto") // light, dark, auto
  primaryColor     String  @default("#1976d2") @map("primary_color")
  compactMode      Boolean @default(false) @map("compact_mode")
  animations       Boolean @default(true)

  // Notifications
  emailNotifications Boolean @default(true) @map("email_notifications")
  pushNotifications  Boolean @default(false) @map("push_notifications")
  notifySchemaCreated Boolean @default(true) @map("notify_schema_created")
  notifyAssignment    Boolean @default(true) @map("notify_assignment")
  notifySubmission    Boolean @default(false) @map("notify_submission")

  // Security
  sessionTimeout      Int     @default(30) @map("session_timeout")
  requirePasswordChange Boolean @default(false) @map("require_password_change")

  // Editor Preferences
  editorTheme    String  @default("vs-dark") @map("editor_theme")
  fontSize       Int     @default(14) @map("font_size")
  tabSize        Int     @default(2) @map("tab_size")
  autoComplete   Boolean @default(true) @map("auto_complete")
  formatOnSave   Boolean @default(true) @map("format_on_save")

  // Advanced Options
  debugMode            Boolean @default(false) @map("debug_mode")
  cacheEnabled         Boolean @default(true) @map("cache_enabled")
  experimentalFeatures Boolean @default(false) @map("experimental_features")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

// ============================================================================
// APPLICATION CONFIGURATION MODELS
// ============================================================================

model AppConfig {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "ui.theme", "features.enableChat"
  value       Json     // Configuration value (can be any JSON type)
  category    String   // "ui", "features", "modules", "branding", etc.
  description String?  // Human-readable description
  isSystem    Boolean  @default(false) @map("is_system") // System vs user-defined
  isPublic    Boolean  @default(true) @map("is_public") // Can users override?

  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isSystem])
  @@map("app_config")
}

model UserConfig {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  key       String   // Configuration key (matches AppConfig.key)
  value     Json     // User's override value

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
  @@map("user_config")
}

model OrganizationConfig {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String   // Configuration key (matches AppConfig.key)
  value          Json     // Organization's override value

  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([key])
  @@map("organization_config")
}

model PluginConfig {
  id             String   @id @default(cuid())
  pluginId       String   @unique @map("plugin_id") // e.g., "auth", "dashboard"
  enabled        Boolean  @default(true)
  config         Json     @default("{}") // Plugin-specific configuration
  priority       Int      @default(0) // Load order priority

  // Override settings
  routes         Json?    // Override plugin routes
  navigation     Json?    // Override plugin navigation

  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([priority])
  @@map("plugin_config")
}

// ============================================================================
// FEATURE FLAG MODELS
// ============================================================================

enum FeatureFlagType {
  BOOLEAN
  PERCENTAGE
  WHITELIST
  DATE_RANGE
  ENVIRONMENT
}

enum FeatureFlagScope {
  USER
  ORGANIZATION
  ROLE
  GLOBAL
}

model FeatureFlag {
  id          String          @id @default(cuid())
  key         String          @unique // e.g., "auth.oauth2.enabled"
  name        String          // Human-readable name
  description String?         // What this flag controls
  type        FeatureFlagType // BOOLEAN, PERCENTAGE, etc.

  // Default value (global)
  enabled Boolean @default(false)

  // Percentage rollout (0-100)
  rolloutPercentage Int? @default(0) @map("rollout_percentage")

  // Date-based activation
  enabledFrom  DateTime? @map("enabled_from")
  enabledUntil DateTime? @map("enabled_until")

  // Environment restrictions
  environments Json? // ["development", "staging", "production"]

  // Metadata
  category String? // "auth", "billing", "workflow", etc.
  tags     Json?   // ["beta", "experimental", "deprecated"]

  // Dependencies
  dependsOn Json? @map("depends_on") // Other feature flags this depends on

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  // Relations
  overrides FeatureFlagOverride[]
  auditLogs FeatureFlagAuditLog[]

  @@index([key])
  @@index([category])
  @@index([enabled])
  @@map("feature_flags")
}

model FeatureFlagOverride {
  id    String           @id @default(cuid())
  flagId String          @map("flag_id")

  // Override scope
  scope FeatureFlagScope // USER, ORGANIZATION, ROLE

  // Target identifiers
  userId         String? @map("user_id")
  organizationId String? @map("organization_id")
  roleId         String? @map("role_id")

  // Override value
  enabled Boolean

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // Relations
  flag         FeatureFlag   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([flagId, scope, userId, organizationId, roleId])
  @@index([flagId])
  @@index([userId])
  @@index([organizationId])
  @@index([scope])
  @@map("feature_flag_overrides")
}

model FeatureFlagAuditLog {
  id     String @id @default(cuid())
  flagId String @map("flag_id")

  action String // "created", "updated", "deleted", "checked", "override_added", "override_removed"

  // Change details
  previousValue Json? @map("previous_value")
  newValue      Json? @map("new_value")

  // Context
  userId         String? @map("user_id")
  organizationId String? @map("organization_id")
  ipAddress      String? @map("ip_address")
  userAgent      String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("feature_flag_audit_logs")
}

// ============================================================================
// DATA MAPPING TEMPLATE MODELS
// ============================================================================

model MappingTemplate {
  id          String   @id @default(cuid())
  name        String   // e.g., "Salesforce Contacts", "HubSpot Companies"
  description String?

  // Provider/Category
  provider    String   // e.g., "salesforce", "hubspot", "stripe", "custom"
  category    String   // e.g., "crm", "payments", "database"
  service     String?  // Specific service (e.g., "contacts", "companies", "customers")

  // Connector type this template is for
  connectorType String @map("connector_type") // "rest_api", "graphql", "database", etc.

  // Template configuration
  rootPath    String?  @map("root_path") // JSONPath for data extraction
  mappings    Json     // Array of FieldMapping objects
  valueField  String?  @map("value_field")
  displayField String? @map("display_field")
  searchFields Json?   @map("search_fields") // Array of searchable field names

  // Sample data for preview
  sampleData  Json?    @map("sample_data")

  // Popularity & ratings
  usageCount  Int      @default(0) @map("usage_count")
  rating      Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")

  // Status & visibility
  status      MappingTemplateStatus @default(ACTIVE)
  visibility  MappingTemplateVisibility @default(PUBLIC) // PUBLIC, ORGANIZATION, PRIVATE

  // Organization (nullable for system templates)
  organizationId String? @map("organization_id")

  // Tags for search
  tags        String[] @default([])

  // Icon/Logo
  icon        String?  // Emoji or icon name
  logoUrl     String?  @map("logo_url")

  // Documentation
  documentation String? @db.Text
  setupInstructions Json? @map("setup_instructions") // Array of setup steps

  // Metadata
  isSystemTemplate Boolean @default(false) @map("is_system_template") // Built-in vs user-created
  isFeatured      Boolean @default(false) @map("is_featured")
  createdBy       String  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([provider, service, connectorType], name: "provider_service_connector_unique")
  @@index([provider])
  @@index([category])
  @@index([connectorType])
  @@index([status])
  @@index([visibility])
  @@index([organizationId])
  @@index([isSystemTemplate])
  @@index([isFeatured])
  @@index([usageCount])
  @@index([rating])
  @@map("mapping_templates")
}

enum MappingTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DEPRECATED

  @@map("mapping_template_status")
}

enum MappingTemplateVisibility {
  PUBLIC      // Available to all
  ORGANIZATION // Available within organization
  PRIVATE     // Only creator

  @@map("mapping_template_visibility")
}

// ============================================================================
// BARE METAL AS A SERVICE (BMaaS) MODELS
// ============================================================================

model BmaasInstance {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")

  // Instance details
  name           String
  description    String?
  flavorId       String   @map("flavor_id")

  // OpenStack identifiers
  openstackId    String   @unique @map("openstack_id") // Nova instance UUID
  openstackProjectId String? @map("openstack_project_id") // OpenStack project UUID

  // Configuration
  imageId        String?  @map("image_id")
  imageName      String?  @map("image_name")
  hypervisor     String?  // KVM, XEN, VMWARE_ESXI, IRONIC
  availabilityZone String? @map("availability_zone")

  // Status
  status         BmaasInstanceStatus @default(PENDING)
  powerState     String?  @map("power_state") // RUNNING, PAUSED, SUSPENDED, SHUTOFF
  taskState      String?  @map("task_state")  // spawning, migrating, etc.

  // Network configuration
  publicIp       String?  @map("public_ip")
  privateIp      String?  @map("private_ip")
  floatingIpId   String?  @map("floating_ip_id")

  // Metadata
  metadata       Json     @default("{}")
  tags           String[] @default([])

  // Billing
  hourlyRate     Decimal  @db.Decimal(10, 4) @map("hourly_rate")
  currency       String   @default("USD")

  // Lifecycle timestamps
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // OpenStack lifecycle
  launchedAt     DateTime? @map("launched_at")
  terminatedAt   DateTime? @map("terminated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flavor         BmaasFlavor @relation(fields: [flavorId], references: [id])
  volumes        BmaasVolume[]
  networkPorts   BmaasNetworkPort[]
  usageRecords   BmaasUsageRecord[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@index([openstackId])
  @@index([createdAt])
  @@map("bmaas_instances")
}

model BmaasFlavor {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  // Compute resources
  vcpus       Int
  ram         Int      // MB
  disk        Int      // GB
  swap        Int      @default(0) // MB
  ephemeral   Int      @default(0) // GB

  // OpenStack mapping
  openstackId String?  @unique @map("openstack_id")

  // Pricing
  hourlyRate  Decimal  @db.Decimal(10, 4) @map("hourly_rate")
  monthlyRate Decimal  @db.Decimal(10, 2) @map("monthly_rate")
  currency    String   @default("USD")

  // Specifications
  bandwidth   Int?     // Mbps
  isPublic    Boolean  @default(true) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")

  // Metadata
  metadata    Json     @default("{}")
  tags        String[] @default([])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  instances   BmaasInstance[]

  @@index([isActive])
  @@index([isPublic])
  @@map("bmaas_flavors")
}

model BmaasNetwork {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")

  // Network details
  name           String
  description    String?

  // OpenStack identifiers
  openstackId    String   @unique @map("openstack_id") // Neutron network UUID

  // Configuration
  cidr           String?
  gateway        String?
  dnsNameservers String[] @default([]) @map("dns_nameservers")
  allocationPools Json?   @map("allocation_pools")

  // Network type
  networkType    String?  @map("network_type") // flat, vlan, vxlan, gre
  segmentationId Int?     @map("segmentation_id")

  // Status
  status         BmaasNetworkStatus @default(PENDING)
  isPublic       Boolean  @default(false) @map("is_public")
  isExternal     Boolean  @default(false) @map("is_external")

  // Billing
  monthlyRate    Decimal  @default(0) @db.Decimal(10, 4) @map("monthly_rate")
  currency       String   @default("USD")

  // Metadata
  metadata       Json     @default("{}")
  tags           String[] @default([])

  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subnets        BmaasSubnet[]
  ports          BmaasNetworkPort[]
  usageRecords   BmaasUsageRecord[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([openstackId])
  @@map("bmaas_networks")
}

model BmaasSubnet {
  id             String   @id @default(cuid())
  networkId      String   @map("network_id")

  name           String
  description    String?

  // OpenStack identifiers
  openstackId    String   @unique @map("openstack_id")

  // Configuration
  cidr           String
  gateway        String?
  ipVersion      Int      @default(4) @map("ip_version") // 4 or 6
  enableDhcp     Boolean  @default(true) @map("enable_dhcp")
  dnsNameservers String[] @default([]) @map("dns_nameservers")
  allocationPools Json    @default("[]") @map("allocation_pools")
  hostRoutes     Json     @default("[]") @map("host_routes")

  // Metadata
  metadata       Json     @default("{}")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  network        BmaasNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@index([networkId])
  @@index([openstackId])
  @@map("bmaas_subnets")
}

model BmaasNetworkPort {
  id             String   @id @default(cuid())
  instanceId     String   @map("instance_id")
  networkId      String   @map("network_id")

  name           String?

  // OpenStack identifiers
  openstackId    String   @unique @map("openstack_id")

  // Configuration
  macAddress     String   @map("mac_address")
  fixedIps       Json     @default("[]") @map("fixed_ips") // Array of {ip_address, subnet_id}
  securityGroups String[] @default([]) @map("security_groups")

  // Status
  status         String   @default("DOWN") // UP, DOWN
  adminStateUp   Boolean  @default(true) @map("admin_state_up")

  // Metadata
  metadata       Json     @default("{}")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  instance       BmaasInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  network        BmaasNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([networkId])
  @@index([openstackId])
  @@map("bmaas_network_ports")
}

model BmaasVolume {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  instanceId     String?  @map("instance_id") // Null if not attached

  name           String
  description    String?

  // OpenStack identifiers
  openstackId    String   @unique @map("openstack_id") // Cinder volume UUID

  // Configuration
  sizeGb         Int      @map("size") // Renamed from size for consistency with code
  volumeType     String   @default("standard") @map("volume_type") // standard, ssd, nvme
  bootable       Boolean  @default(false)
  encrypted      Boolean  @default(false)

  // Attachment details
  attachedDevice String?  @map("device") // Renamed from device for consistency with code
  attachmentId   String?  @unique @map("attachment_id")

  // Status
  status         BmaasVolumeStatus @default(CREATING)

  // Billing
  monthlyRatePerGb Decimal @db.Decimal(10, 4) @map("monthly_rate_per_gb")
  currency         String  @default("USD")

  // Snapshot info
  snapshotId     String?  @map("snapshot_id")
  sourceVolId    String?  @map("source_vol_id")

  // Metadata
  metadata       Json     @default("{}")
  tags           String[] @default([])

  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  attachedAt     DateTime? @map("attached_at")
  detachedAt     DateTime? @map("detached_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instance       BmaasInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  usageRecords   BmaasUsageRecord[]

  @@index([organizationId])
  @@index([projectId])
  @@index([instanceId])
  @@index([status])
  @@index([openstackId])
  @@map("bmaas_volumes")
}

model BmaasBucket {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")

  name           String   // Bucket name (globally unique in Swift)
  description    String?

  // OpenStack identifiers
  openstackId    String @unique @map("openstack_container") // Renamed from openstackContainer for consistency

  // Configuration
  region         String?
  storageClass   String   @default("standard") @map("storage_class") // standard, archive
  isPublic       Boolean  @default(false) @map("is_public")
  versioning     Boolean  @default(false)

  // Capacity tracking
  objectCount    Int      @default(0) @map("object_count")
  bytesUsed      BigInt   @default(0) @map("bytes_used")
  sizeBytes      BigInt   @default(0) @map("size_bytes") // Alias for total bucket size

  // Billing
  storageRatePerGb Decimal @db.Decimal(10, 4) @map("storage_rate_per_gb")
  transferRatePerGb Decimal @db.Decimal(10, 4) @map("transfer_rate_per_gb")
  requestRate      Decimal @default(0) @db.Decimal(10, 6) @map("request_rate")
  currency         String  @default("USD")

  // Status
  status         BmaasBucketStatus @default(ACTIVE)

  // Access control
  readAcl        Json?    @map("read_acl")
  writeAcl       Json?    @map("write_acl")

  // Metadata
  metadata       Json     @default("{}")
  tags           String[] @default([])

  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  lastSyncedAt   DateTime? @map("last_synced_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usageRecords   BmaasUsageRecord[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([openstackId])
  @@map("bmaas_buckets")
}

model BmaasUsageRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")

  // Resource identification
  resourceType   BmaasResourceType @map("resource_type")
  resourceId     String   @map("resource_id")
  instanceId     String?  @map("instance_id")
  volumeId       String?  @map("volume_id")
  networkId      String?  @map("network_id")
  bucketId       String?  @map("bucket_id")

  // Usage metrics
  metric         String   // compute_hours, storage_gb_hours, network_gb_out, requests
  quantity       Decimal  @db.Decimal(20, 6)
  unit           String   // hours, GB, requests

  // Pricing
  unitPrice      Decimal  @db.Decimal(10, 6) @map("unit_price")
  totalCost      Decimal  @db.Decimal(10, 4) @map("total_cost")
  currency       String   @default("USD")

  // Time window
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")

  // Metadata
  metadata       Json     @default("{}")

  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instance       BmaasInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  volume         BmaasVolume? @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  network        BmaasNetwork? @relation(fields: [networkId], references: [id], onDelete: SetNull)
  bucket         BmaasBucket? @relation(fields: [bucketId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([resourceType])
  @@index([resourceId])
  @@index([startTime])
  @@index([endTime])
  @@index([createdAt])
  @@index([organizationId, startTime, endTime])
  @@map("bmaas_usage_records")
}

model BmaasQuota {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")

  // Compute quotas
  maxInstances   Int      @default(10) @map("max_instances")
  maxVcpus       Int      @default(50) @map("max_vcpus")
  maxRamMb       Int      @default(131072) @map("max_ram_mb") // 128 GB

  // Storage quotas
  maxVolumes     Int      @default(20) @map("max_volumes")
  maxStorageGb   Int      @default(1000) @map("max_volume_gb") // Renamed from maxVolumeGb for consistency
  maxSnapshots   Int      @default(50) @map("max_snapshots")
  maxBuckets     Int      @default(10) @map("max_buckets")
  maxBucketGb    Int      @default(5000) @map("max_bucket_gb")

  // Network quotas
  maxNetworks    Int      @default(5) @map("max_networks")
  maxSubnets     Int      @default(10) @map("max_subnets")
  maxPorts       Int      @default(50) @map("max_ports")
  maxFloatingIps Int      @default(5) @map("max_floating_ips")
  maxSecurityGroups Int   @default(10) @map("max_security_groups")

  // Current usage (cached for performance)
  usedInstances  Int      @default(0) @map("used_instances")
  usedVcpus      Int      @default(0) @map("used_vcpus")
  usedRamMb      Int      @default(0) @map("used_ram_mb")
  usedVolumes    Int      @default(0) @map("used_volumes")
  usedStorageGb  Int      @default(0) @map("used_volume_gb") // Renamed from usedVolumeGb for consistency
  usedNetworks   Int      @default(0) @map("used_networks")
  usedBuckets    Int      @default(0) @map("used_buckets")

  // Metadata
  metadata       Json     @default("{}")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bmaas_quotas")
}

