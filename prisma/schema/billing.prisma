// Billing, subscriptions, invoices, and payments
// ============================================================================

model BillingAccount {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  name            String
  email           String
  status          BillingAccountStatus @default(ACTIVE)
  paymentMethodId String?              @map("payment_method_id")
  billingAddress  Json?                @map("billing_address")
  taxId           String?              @map("tax_id")
  currency        String               @default("USD")
  metadata        Json                 @default("{}")

  // Stripe integration fields
  stripeCustomerId String? @unique @map("stripe_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]
  invoices         Invoice[]
  paymentHistory   PaymentHistory[]
  billingAlerts    BillingAlert[]
  paymentMethods   PaymentMethod[]
  billingAddresses BillingAddress[]

  @@map("billing_accounts")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  tier        PlanTier
  pricing     Json
  features    Json
  limits      Json
  isActive    Boolean  @default(true) @map("is_active")

  // Stripe integration
  stripePriceId   String? @unique @map("stripe_price_id")
  stripeProductId String? @map("stripe_product_id")
  trialDays       Int?    @map("trial_days")
  metadata        Json?   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  billingAccountId   String             @map("billing_account_id")
  projectId          String             @map("project_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialStart         DateTime?          @map("trial_start")
  trialEnd           DateTime?          @map("trial_end")
  cancelAt           DateTime?          @map("cancel_at")
  canceledAt         DateTime?          @map("canceled_at")
  metadata           Json               @default("{}")

  // Stripe integration fields
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  usageRecords   UsageRecord[]
  invoices       Invoice[]

  @@map("subscriptions")
}

model UsageRecord {
  id             String      @id @default(cuid())
  subscriptionId String      @map("subscription_id")
  projectId      String      @map("project_id")
  metric         UsageMetric
  quantity       Decimal     @db.Decimal(15, 6)
  unit           String
  timestamp      DateTime
  metadata       Json        @default("{}")
  cost           Decimal     @default(0) @db.Decimal(10, 4)
  currency       String      @default("USD")
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model ExecutionUsage {
  id            String          @id @default(cuid())
  executionId   String          @unique @map("execution_id")
  projectId     String          @map("project_id")
  workflowId    String          @map("workflow_id")
  userId        String          @map("user_id")
  domain        String?
  startTime     DateTime        @map("start_time")
  endTime       DateTime?       @map("end_time")
  duration      Int? // seconds
  status        ExecutionStatus
  resourceUsage Json            @map("resource_usage")
  cost          Json
  createdAt     DateTime        @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([startTime])
  @@index([projectId, status])
  @@map("execution_usage")
}

model Invoice {
  id               String        @id @default(cuid())
  billingAccountId String        @map("billing_account_id")
  subscriptionId   String?       @map("subscription_id")
  invoiceNumber    String        @unique @map("invoice_number")
  status           InvoiceStatus @default(DRAFT)
  subtotal         Decimal       @db.Decimal(10, 2)
  tax              Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  periodStart      DateTime      @map("period_start")
  periodEnd        DateTime      @map("period_end")
  dueDate          DateTime      @map("due_date")
  paidAt           DateTime?     @map("paid_at")
  lineItems        Json          @default("[]") @map("line_items")
  metadata         Json          @default("{}")

  // Stripe integration fields
  stripeInvoiceId String? @unique @map("stripe_invoice_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentHistory PaymentHistory[]

  @@index([billingAccountId])
  @@index([status])
  @@index([dueDate])
  @@index([paidAt])
  @@index([billingAccountId, status])
  @@map("invoices")
}

model PaymentHistory {
  id               String        @id @default(cuid())
  billingAccountId String        @map("billing_account_id")
  invoiceId        String?       @map("invoice_id")
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  status           PaymentStatus
  paymentMethod    String?       @map("payment_method")
  transactionId    String?       @map("transaction_id")
  failureReason    String?       @map("failure_reason")
  metadata         Json          @default("{}")
  processedAt      DateTime      @default(now()) @map("processed_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payment_history")
}

model BillingAlert {
  id               String           @id @default(cuid())
  billingAccountId String           @map("billing_account_id")
  type             BillingAlertType
  severity         AlertSeverity
  message          String
  threshold        Decimal?         @db.Decimal(15, 6)
  currentValue     Decimal?         @map("current_value") @db.Decimal(15, 6)
  isResolved       Boolean          @default(false) @map("is_resolved")
  resolvedAt       DateTime?        @map("resolved_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("billing_alerts")
}

model PaymentMethod {
  id               String @id @default(cuid())
  billingAccountId String @map("billing_account_id")
  type             String @default("card") // card, bank_account, etc.

  // Card details (last 4, brand, expiry)
  brand       String? // visa, mastercard, amex, etc.
  last4       String?
  expiryMonth Int?    @map("expiry_month")
  expiryYear  Int?    @map("expiry_year")

  // Status
  isDefault Boolean @default(false) @map("is_default")
  isExpired Boolean @default(false) @map("is_expired")

  // Stripe integration
  stripePaymentMethodId String? @unique @map("stripe_payment_method_id")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model BillingAddress {
  id               String  @id @default(cuid())
  billingAccountId String? @map("billing_account_id")
  userId           String? @map("user_id")

  // Address details
  name        String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String  @map("postal_code")
  country     String
  phoneNumber String? @map("phone_number")

  // Status
  isDefault Boolean @default(false) @map("is_default")

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  billingAccount BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_addresses")
}

enum BillingAccountStatus {
  ACTIVE
  SUSPENDED
  DELINQUENT
  CLOSED

  @@map("billing_account_status")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID

  @@map("subscription_status")
}

enum PlanTier {
  FREE
  BASIC
  STARTER
  PROFESSIONAL
  PREMIUM
  ENTERPRISE

  @@map("plan_tier")
}

enum UsageMetric {
  EXECUTIONS
  CPU_HOURS
  MEMORY_GB_HOURS
  STORAGE_GB
  NETWORK_GB
  USERS
  PROJECTS
  FORMS
  FORM_SUBMISSIONS
  FORM_FIELDS
  FORM_ASSIGNMENTS
  CONNECTORS
  CONNECTOR_CALLS
  WORKFLOWS
  WORKFLOW_DRAFTS
  WORKFLOW_VERSIONS
  MARKETPLACE_LISTINGS
  WORKFLOW_PURCHASES
  ALERTS
  ALERT_RULES
  API_KEYS
  API_CALLS
  WEBHOOK_ENDPOINTS
  CUSTOM_ROLES
  ORGANIZATIONS
  INVITATIONS
  COMMENTS
  TASKS
  LAUNCH_PLANS
  SUPPORT_TICKETS

  @@map("usage_metric")
}

enum ExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABORTED
  TIMED_OUT

  @@map("execution_status")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE

  @@map("invoice_status")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED

  @@map("payment_status")
}

enum BillingAlertType {
  USAGE_LIMIT
  COST_SPIKE
  PAYMENT_FAILED
  TRIAL_ENDING

  @@map("billing_alert_type")
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("alert_severity")
}

