{
  "name": "next-ts-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/core/*",
    "packages/features/*",
    "packages/integrations/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm next dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "type-check:packages": "turbo run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "create-plugin": "node scripts/create-plugin.js",
    "list-plugins": "node scripts/list-plugins.js",
    "validate-plugins": "node scripts/validate-plugins.js",
    "enable-plugin": "node scripts/enable-plugin.js",
    "disable-plugin": "node scripts/enable-plugin.js --disable",
    "plugin-info": "node scripts/plugin-info.js",
    "migrate-plugins": "node scripts/migrate-to-plugin-manifest.js",
    "discover-plugins": "node scripts/discover-plugins.js",
    "schema:build": "node scripts/prisma/build-schema.js",
    "schema:split": "node scripts/prisma/split-schema.js",
    "db:generate": "pnpm schema:build && prisma generate",
    "db:migrate": "pnpm schema:build && prisma migrate dev",
    "db:migrate:deploy": "pnpm schema:build && prisma migrate deploy",
    "db:migrate:reset": "pnpm schema:build && prisma migrate reset --force",
    "db:push": "pnpm schema:build && prisma db push",
    "db:pull": "prisma db pull",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:validate": "pnpm schema:build && prisma validate",
    "db:status": "pnpm schema:build && prisma migrate status",
    "db:setup": "pnpm schema:build && prisma generate && prisma migrate deploy && prisma db seed",
    "db:reset": "pnpm schema:build && prisma migrate reset --force && prisma generate && prisma db seed",
    "db:dev": "pnpm schema:build && prisma migrate dev --name"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.0.0",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.2",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.15.3",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "protobufjs": "^7.5.4",
    "qrcode": "^1.5.4",
    "redis": "^4.6.0",
    "speakeasy": "^2.0.0",
    "stripe": "^20.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
